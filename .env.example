# Interface the containers publish on. Keep 127.0.0.1 when a reverse proxy on the host fronts them.
BIND_ADDR=127.0.0.1
SITE_PORT=8081
APP_PORT=8082
BRIDGE_PORT=8083

# Where the landing page links to and where the client finds the bridge (relative to the client URL).
APP_URL=app/
BRIDGE_URL=../bridge
# Extra CSP connect-src entries for a bridge on another origin (wss://bridge.example.org) and for the
# iroh relays of chatmail servers whose users add Kitepost as second device (wss://chat.example.org
# https://chat.example.org). Relays on the app's own origin are covered by 'self'.
CONNECT_SRC=
# Relay offered when creating a new profile.
DEFAULT_RELAY=nine.testrun.org

# Strongly recommended: restrict the bridge to your own relay(s), e.g. chat.example.org or *.example.org.
# Empty allows any public host on the allowed ports.
BRIDGE_ALLOWED_HOSTS=
# Fixed name=ip pairs, the only way to reach private addresses (e.g. a relay on the same host).
BRIDGE_HOST_MAP=
# Behind chatmail's nginx all clients appear as 127.0.0.1, raise this to e.g. 500 there.
BRIDGE_MAX_CONNECTIONS_PER_IP=16
# Extra browser origins allowed to use the bridge (same origin is always allowed).
BRIDGE_ALLOWED_ORIGINS=

# Invite service (`--profile invite`), runs on the chatmail host.
MAIL_DOMAIN=chat.example.org
# At least 24 characters, e.g. `openssl rand -base64 32`. Empty disables the admin page.
INVITE_ADMIN_TOKEN=
# The relay's mailbox directory on the host and the uid/gid of its vmail user.
CHATMAIL_MAILBOXES_DIR=/srv/chatmail/data/mail/mail/chat.example.org
VMAIL_UID=996
VMAIL_GID=996
INVITE_PORT=8084
# Link from the invite result page to the web client, relative to /join/<token>.
INVITE_APP_URL=../app/
# Public URL of the invite service, for the QR code to its install page. Default: https://<host>/join/
INVITE_PUBLIC_URL=

# Only for the optional bundled Caddy (`--profile caddy`).
DOMAIN=localhost
